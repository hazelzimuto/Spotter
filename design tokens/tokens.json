      }
    }
  },

  "accessibility": {
    "minTouchTarget": "44px",
    "contrast": {
      "textOnSurface": "AA (>= 4.5:1)",
      "largeTextOnSurface": "AA (>= 3:1)",
      "interactiveElements": "AA (>= 3:1)"
    },
    "focusIndicator": {
      "style": "solid ring",
      "width": "{semantic.state.focus.ringWidth}",
      "offset": "{semantic.state.focus.ringOffset}",
      "color": "{themes.light.color.primary}"
