      "height": "32px",
      "variants": {
        "default": {
          "background": "{themes.light.color.surfaceContainer}",
          "foreground": "{themes.light.color.onSurfaceVariant}"
        },
        "selected": {
          "background": "{themes.light.color.primaryContainer}",
          "foreground": "{themes.light.color.onPrimaryContainer}"
        },
        "success": {
          "background": "{themes.light.color.successContainer}",
          "foreground": "{themes.light.color.onSuccessContainer}"
        },
        "warning": {
          "background": "{themes.light.color.warningContainer}",
          "foreground": "{themes.light.color.onWarningContainer}"
        },
        "error": {
          "background": "{themes.light.color.errorContainer}",
          "foreground": "{themes.light.color.onErrorContainer}"
        },
        "information": {
          "background": "{themes.light.color.infoContainer}",
          "foreground": "{themes.light.color.onInfoContainer}"
        }
      }
    },

    "badge": {
      "neutral": {
        "background": "{primitives.color.neutral.90}",
        "foreground": "{primitives.color.neutral.20}"
