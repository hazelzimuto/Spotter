/**
 * Environment variable names — read rules/environment.md before editing this file.
 *
 * RULES:
 * - Server credentials must NOT be prefixed NEXT_PUBLIC_.
 * - NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY is the only public client-side credential.
 * - All server actions must validate presence of required env vars at startup.
 */

# ------ DATABASE ------
DATABASE_URL=

# ------ PAYSTACK ------
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ------ AI MODELS ------
GEMINI_API_KEY=
OPENAI_API_KEY=
